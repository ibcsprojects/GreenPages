{
  "name": "greenpages",
  "version": "0.2.0",
  "private": true,
  "description": "GreenPages: an eco-formatting assistant for Google Docs. Flags wasteful print formatting and suggests paper and ink saving fixes you accept one at a time.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:nocheck": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "site:vendor": "node scripts/vendor-pdfjs.mjs",
    "notices": "node scripts/notices.mjs"
  },
  "dependencies": {
    "framer-motion": "^14.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.26",
    "@types/chrome": "^0.0.270",
    "@types/node": "^22.19.21",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "pdfjs-dist": "^5.6.205",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "license": "MIT"
}
